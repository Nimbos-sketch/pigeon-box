generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  gmailAccounts GmailAccount[]
  settings      UserSettings?
  emailFolders  EmailFolder[]
  senderRules   SenderRule[]
  orgMemberships OrganizationMember[]
  orgBroadcasts  OrgBroadcast[]
  pigeonHoles        PigeonHole[]
  sentPigeonMessages PigeonHoleMessage[] @relation("SentPigeonMessages")
  teamLinkRequests   OrgTeamLink[]       @relation("TeamLinkRequester")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GmailAccount {
  id                 String      @id @default(cuid())
  userId             String
  email              String
  encryptedRefresh   String
  encryptedAccess    String?
  accessExpiresAt    DateTime?
  historyId          String?
  lastSyncedAt       DateTime?
  syncCursorError    String?
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  labels             GmailLabel[]
  messages           GmailMessage[]
  syncStates         SyncState[]
  auditLogs          AuditLog[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([userId, email])
}

model GmailLabel {
  id          String       @id @default(cuid())
  accountId   String
  gmailId     String
  name        String
  type        String
  colorJson   String?
  account     GmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime     @default(now())

  @@unique([accountId, gmailId])
}

model GmailMessage {
  id            String       @id @default(cuid())
  accountId     String
  gmailId       String
  threadId      String
  subject       String?
  fromAddress   String?
  snippet       String?
  bodyText      String?
  bodyHtml      String?
  internalDate  DateTime?
  isUnread      Boolean      @default(false)
  isStarred     Boolean      @default(false)
  labelIdsJson  String       @default("[]")
  account       GmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([accountId, gmailId])
  @@index([accountId, internalDate])
}

model SyncState {
  id          String       @id @default(cuid())
  accountId   String
  syncType    String
  status      String
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  detailsJson String?
  account     GmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String       @id @default(cuid())
  accountId  String
  action     String
  targetId   String?
  metaJson   String?
  createdAt  DateTime     @default(now())
  account    GmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String?
  signature       String?
  replyBehavior   String   @default("reply")
  forwardPrefix   String   @default("Fwd:")
  autoBcc         String?
  vacationEnabled Boolean  @default(false)
  vacationMessage String?
  settingsJson    String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EmailFolder {
  id           String   @id @default(cuid())
  userId       String
  name         String
  gmailLabelId String
  color        String   @default("#f59e0b")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderRules  SenderRule[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model SenderRule {
  id              String       @id @default(cuid())
  userId          String
  senderKey       String
  preferredAction String
  folderId        String?
  actionCount     Int          @default(1)
  autoApply       Boolean      @default(false)
  lastActionAt    DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder          EmailFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, senderKey])
  @@index([userId, autoApply])
}

model Organization {
  id         String               @id @default(cuid())
  name       String
  slug       String               @unique
  members    OrganizationMember[]
  broadcasts OrgBroadcast[]
  pigeonHoles PigeonHole[]
  linksFrom  OrgTeamLink[]        @relation("LinkFrom")
  linksTo    OrgTeamLink[]        @relation("LinkTo")
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

model OrganizationMember {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([orgId, userId])
  @@index([userId])
}

model OrgBroadcast {
  id          String       @id @default(cuid())
  orgId       String
  authorId    String
  headline    String
  body        String
  noticeType  String       @default("general")
  emailed     Boolean      @default(false)
  publishedAt DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId, publishedAt])
}

model PigeonHole {
  id           String              @id @default(cuid())
  orgId        String
  userId       String?
  ownerUserId  String?
  contactEmail String?
  kind         String              @default("member")
  slotCode     String
  label        String?
  createdById  String?
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     PigeonHoleMessage[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([orgId, userId])
  @@unique([orgId, ownerUserId, contactEmail])
  @@unique([orgId, ownerUserId, slotCode])
  @@index([orgId])
  @@index([userId])
  @@index([ownerUserId])
  @@index([contactEmail])
}

model PigeonHoleMessage {
  id              String     @id @default(cuid())
  holeId          String
  senderId        String
  senderOrgId     String
  subject         String
  body            String
  status          String     @default("unread")
  obligationQueue String     @default("action")
  hole            PigeonHole @relation(fields: [holeId], references: [id], onDelete: Cascade)
  sender          User       @relation("SentPigeonMessages", fields: [senderId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([holeId, status, createdAt])
  @@index([senderId, createdAt])
}

model OrgTeamLink {
  id          String       @id @default(cuid())
  fromOrgId   String
  toOrgId     String
  status      String       @default("pending")
  requestedBy String
  approvedBy  String?
  fromOrg     Organization @relation("LinkFrom", fields: [fromOrgId], references: [id], onDelete: Cascade)
  toOrg       Organization @relation("LinkTo", fields: [toOrgId], references: [id], onDelete: Cascade)
  requester   User         @relation("TeamLinkRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([fromOrgId, toOrgId])
  @@index([toOrgId, status])
}
